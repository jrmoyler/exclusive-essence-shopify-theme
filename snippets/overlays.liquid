    <section class="mobile-menu-group"><h4>Discover</h4>
      <a href="{{ routes.root_url }}#brands"><span>Featured Brands</span><small>Shop familiar beauty names</small></a>
      <a href="{{ routes.root_url }}#deals"><span>Store Specials</span><small>Promotions and product spotlights</small></a>
