<div class="overlay" id="overlay" aria-hidden="true"></div>

<aside class="drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-labelledby="cartDrawerTitle" aria-hidden="true" tabindex="-1">
  <div class="drawer-head">
    <h3 id="cartDrawerTitle">Your Cart</h3>
    <button class="icon-btn" type="button" data-close aria-label="Close cart"><svg class="icon" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg></button>
  </div>
  <div class="drawer-body" id="cartItems" aria-live="polite">
    {%- if cart.item_count == 0 -%}
      <p class="drawer-empty">Your cart is empty.<br><br><a class="btn btn-secondary" href="{{ routes.all_products_collection_url }}">Start Shopping</a></p>
    {%- else -%}
      <p class="drawer-empty">Loading your cart…</p>
    {%- endif -%}
  </div>
  <form class="drawer-foot" id="cartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate>
    <fieldset class="purchase-toggle" id="purchaseToggle">
      <legend class="sr-only">How would you like to pay?</legend>
      <label class="active" data-purchase="full"><input type="radio" name="ee_purchase_option" value="full" checked><span>Pay in Full</span></label>
      <label data-purchase="layaway"><input type="radio" name="ee_purchase_option" value="layaway"><span>Layaway Plan</span></label>
    </fieldset>
    <div class="layaway-panel" id="layawayPanel">
      <div class="lp-row"><span>Total price</span><b id="lpTotal">$0.00</b></div>
      <div class="lp-row"><span>Deposit (25%)</span><b id="lpDeposit">$0.00</b></div>
      <div class="lp-row"><span>Remaining balance</span><b id="lpRemaining">$0.00</b></div>
      <div class="lp-row"><span>Final payment due</span><b id="lpDueDate">—</b></div>
      <label class="sr-only" for="lpName">Full name</label>
      <input type="text" id="lpName" placeholder="Full name" autocomplete="name">
      <label class="sr-only" for="lpPhone">Phone number</label>
      <input type="tel" id="lpPhone" placeholder="Phone number" autocomplete="tel" inputmode="tel">
      <label class="sr-only" for="lpEmail">Email address</label>
      <input type="email" id="lpEmail" placeholder="Email address" autocomplete="email">
      <label class="sr-only" for="lpMethod">Preferred payment method</label>
      <select id="lpMethod"><option value="Credit Card">Credit Card</option><option value="Debit Card">Debit Card</option><option value="Cash">Cash</option><option value="Other">Other</option></select>
      <label class="layaway-agree"><input type="checkbox" id="lpAgree"><span>I have read and agree to the <a href="#layawayModal" data-open-layaway>Layaway Agreement</a>, including the 25% deposit, 45-day term and non-refundable cancellation policy.</span></label>
      <div class="lp-note">Layaway is arranged with our store team. We will call or email you to collect the 25% deposit, confirm your payment schedule and send a signed copy of the agreement. Your items are reserved once the deposit is paid.</div>
      <div class="ee-form-errors" id="layawayErrors" role="alert" hidden></div>
    </div>
    <div class="total-row"><span>Subtotal</span><span id="cartTotal">{{ cart.total_price | money }}</span></div>
    <p class="drawer-fine-print" id="cartFinePrint">Taxes and shipping calculated at checkout. <a href="{{ routes.cart_url }}">View full cart</a></p>
    <input type="hidden" name="checkout" value="">
    <button class="btn btn-primary" type="submit" id="checkoutBtn"{% if cart.item_count == 0 %} disabled{% endif %}>Checkout Securely</button>
  </form>
</aside>

{%- comment -%}
  Layaway requests are delivered to the store through Shopify's contact form,
  so they land in the store inbox. The drawer script fills and submits it.
{%- endcomment -%}
{% form 'contact', id: 'layawayContactForm', class: 'sr-only', aria-hidden: 'true' %}
  {%- if form.posted_successfully? -%}
    <span id="layawaySent" hidden></span>
  {%- elsif form.errors -%}
    <span id="layawayFailed" hidden>{{ form.errors | default_errors | strip_html | escape }}</span>
  {%- endif -%}
  <input type="hidden" name="contact[name]" value="">
  <input type="hidden" name="contact[email]" value="">
  <input type="hidden" name="contact[phone]" value="">
  <input type="hidden" name="contact[Request type]" value="Layaway">
  <textarea name="contact[body]" tabindex="-1"></textarea>
{% endform %}

<aside class="drawer" id="wishlistDrawer" role="dialog" aria-modal="true" aria-labelledby="wishlistDrawerTitle" aria-hidden="true" tabindex="-1">
  <div class="drawer-head">
    <h3 id="wishlistDrawerTitle">Your Wishlist</h3>
    <button class="icon-btn" type="button" data-close aria-label="Close wishlist"><svg class="icon" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg></button>
  </div>
  <div class="drawer-body" id="wishlistItems" aria-live="polite"></div>
  <div class="drawer-foot">
    <p class="drawer-fine-print">Saved on this device. Tap the heart on any product to add it.</p>
    <a class="btn btn-secondary" href="{{ routes.all_products_collection_url }}">Keep Shopping</a>
  </div>
</aside>

