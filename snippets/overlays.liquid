      <a href="{% render 'collection-url', handle: 'skin-body' %}"><span>Skin & Body</span><small>Skin care & body care</small></a>
      <a href="{% render 'collection-url', handle: 'beauty-fashion' %}"><span>Beauty & Fashion</span><small>Lashes, cosmetics & accessories</small></a>
      <a href="{% render 'collection-url', handle: 'essentials' %}"><span>Essentials</span><small>Everyday beauty basics</small></a>
