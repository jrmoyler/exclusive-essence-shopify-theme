{%- liquid
  assign image = product.featured_image
  assign card_variant = product.selected_or_first_available_variant
  assign priced = false
  if product.price_max > 0
    assign priced = true
  endif
  assign needs_options = false
  if product.has_only_default_variant == false and product.variants.size > 1
    assign needs_options = true
  endif
-%}
<article class="product-card" data-product-id="{{ product.id }}" data-handle="{{ product.handle }}">
  <div class="product-media">
    {% unless product.available %}
      <span class="badge badge-soldout">Sold Out</span>
    {% else %}
      {% if product.compare_at_price > product.price %}
        <span class="badge">Sale</span>
      {% elsif product.tags contains 'New' or product.tags contains 'new' %}
        <span class="badge">New</span>
      {% endif %}
    {% endunless %}
    <button class="wish" type="button" data-wish-handle="{{ product.handle }}" data-wish-title="{{ product.title | escape }}" aria-pressed="false" aria-label="Save {{ product.title | escape }} to wishlist">
      <svg class="icon" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"></path></svg>
    </button>
    <a class="product-media-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {% if image %}
        {% render 'hi-res-image', image: image, alt: product.title, sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 48vw', loading: 'lazy' %}
      {% else %}
        <img loading="lazy" src="{{ 'e76907a047b4.webp' | asset_url }}" alt="{{ product.title | escape }}" width="800" height="800">
      {% endif %}
    </a>
  </div>
  <div class="product-body">
    {% if product.vendor != blank %}
      <div class="product-brand">{{ product.vendor }}</div>
    {% endif %}
    <div class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></div>
    <div class="product-meta">
      <span class="price">
        {% if priced == false %}
          In Store
        {% elsif product.price_varies %}
          From {{ product.price_min | money }}
        {% else %}
          {{ product.price | money }}
        {% endif %}
        {% if priced and product.compare_at_price > product.price %}
          <s class="ee-compare">{{ product.compare_at_price | money }}</s>
        {% endif %}
      </span>
    </div>
    <div class="card-actions">
      {% if product.available == false %}
        <button class="add-btn" type="button" disabled>Sold Out</button>
      {% elsif priced == false %}
        <a class="add-btn" href="{{ product.url }}">In Store Only</a>
      {% elsif needs_options %}
        <a class="add-btn" href="{{ product.url }}">Choose Options</a>
      {% else %}
        {% form 'product', product, class: 'js-product-form' %}
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="add-btn" type="submit" name="add">Add to Cart</button>
        {% endform %}
      {% endif %}
      <a class="quick-btn" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
    </div>
  </div>
</article>
