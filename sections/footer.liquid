<footer class="footer"><div class="container"><div class="footer-grid"><div><img class="footer-logo" src="{{ 'b277e37070df.png' | asset_url }}" data-asset="logo" alt="Exclusive Essence"><p>Premium beauty supply store for human hair, hair care, color and professional beauty essentials.</p></div><div><h4>Shop</h4><a href="#catalog" data-filter-link="Human Hair">Human Hair</a><a href="#catalog" data-filter-link="Hair Care">Hair Care</a><a href="#catalog" data-filter-link="Hair Color">Hair Color</a><a href="#catalog" data-filter-link="Essentials">Essentials</a><a href="#new">New Arrivals</a><a href="#brands">Brands</a></div><div><h4>Customer Care</h4><a href="#stores" data-open-stores>Our Stores</a><a href="#visit">Local Pickup</a>{% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">Shipping Policy</a>{% endif %}{% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Return Policy</a>{% endif %}<a href="#" data-open-layaway>Layaway Agreement</a>{% if pages.contact %}<a href="{{ pages.contact.url }}">Contact</a>{% else %}<a href="#visit">Contact</a>{% endif %}</div><div><h4>Join the Essence List</h4><p>Get new-arrival alerts, restock updates and local-store offers.</p>{% form 'customer', class: 'newsletter', id: 'newsletterForm' %}
<input type="hidden" name="contact[tags]" value="newsletter,essence-list">
<input type="hidden" name="contact[accepts_marketing]" value="true">
<input class="ee-hp" type="text" name="contact[company]" tabindex="-1" aria-hidden="true" autocomplete="off">
<input type="email" name="contact[email]" placeholder="Email address" required autocomplete="email">
<button type="submit">Join</button>
{% endform %}</div></div><div class="footer-bottom"><span>© {{ "now" | date: "%Y" }} {{ shop.name }}.</span></div></div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type":"text","id":"heading","label":"Newsletter heading","default":"Join the Essence List"},
    {"type":"textarea","id":"newsletter_text","label":"Newsletter text","default":"Get new-arrival alerts, restock updates and local-store offers."}
  ]
}
{% endschema %}
