<section class="ee-shopify-main customer">
  <div class="container">
    <h1>Hello{% if customer.first_name %}, {{ customer.first_name }}{% endif %}</h1>
    <p class="ee-lede"><a href="{{ routes.account_logout_url }}">Log out</a> · <a href="{{ routes.account_addresses_url }}">Addresses</a></p>
    <h2 style="font-family:Georgia,serif">Order history</h2>
    {% if customer.orders.size == 0 %}
      <p>You have not placed any orders yet.</p>
      <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Shop the catalog</a>
    {% else %}
      <table class="cart-table">
        <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
          {% for order in customer.orders %}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_net_amount | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>
</section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
