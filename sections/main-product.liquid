{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
<section class="ee-shopify-main ee-product-page" data-product-section data-product-id="{{ product.id }}">
  <div class="container">
    <nav class="ee-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Catalog</a>
      {% if collection %}
        <span aria-hidden="true">/</span>
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {% elsif product.type != blank %}
        <span aria-hidden="true">/</span>
        <a href="{{ product.type | url_for_type }}">{{ product.type }}</a>
      {% endif %}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="ee-product-grid">
      <div class="ee-product-media-col">
        <button class="ee-product-media" type="button" id="eeMainMedia" aria-label="View larger image of {{ product.title | escape }}">
          {% if featured %}
            {% render 'hi-res-image', image: featured, alt: product.title, sizes: '(min-width: 900px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'ee-main-photo' %}
          {% else %}
            <img src="{{ 'e76907a047b4.webp' | asset_url }}" alt="{{ product.title | escape }}" class="ee-main-photo" width="1600" height="1600">
          {% endif %}
        </button>
        {% if product.images.size > 1 %}
          <div class="ee-thumbs">
            {% for image in product.images %}
              <button type="button" class="ee-thumb{% if image == featured %} is-active{% endif %}" data-full="{{ image | image_url: width: 2000 }}" data-srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 2000 }} 2000w" aria-label="Show image {{ forloop.index }}" aria-pressed="{% if image == featured %}true{% else %}false{% endif %}">
                <img src="{{ image | image_url: width: 240 }}" srcset="{{ image | image_url: width: 160 }} 160w, {{ image | image_url: width: 320 }} 320w" alt="{{ image.alt | default: product.title | escape }}" width="120" height="120" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="ee-product-copy">
        {% if section.settings.show_vendor and product.vendor != blank %}
          <div class="product-brand">{{ product.vendor }}{% if product.type != blank %} · {{ product.type }}{% endif %}</div>
        {% endif %}
        <h1>{{ product.title }}</h1>
        <div class="ee-price" id="eePrice" aria-live="polite">
          {%- if current_variant.price > 0 -%}
            <span data-price>{{ current_variant.price | money }}</span>
            <s class="ee-compare" data-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          {%- else -%}
            <span data-price>Price available in store</span>
            <s class="ee-compare" data-compare hidden></s>
          {%- endif -%}
        </div>
        {% if section.settings.show_pickup %}
          <p class="ee-pickup">{% if product.available %}Available for pickup{% else %}Ask about availability{% endif %} at 2100 Cleveland Ave, Columbus · Mon–Sat 10 AM–10 PM · Sun 12–6 PM</p>
        {% endif %}

        {% form 'product', product, class: 'ee-form', id: 'eeProductForm', data-product-form: '' %}
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="ee-variant">
                <fieldset>
                  <legend>{{ option.name }}</legend>
                  <div class="ee-swatches">
                    {% for value in option.values %}
                      <label class="ee-swatch">
                        <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              </div>
            {% endfor %}
          {% endunless %}
          <script type="application/json" id="eeVariantJson">
            [
            {%- for v in product.variants -%}
              {%- if v.featured_image -%}
                {%- capture v_srcset -%}{{ v.featured_image | image_url: width: 800 }} 800w, {{ v.featured_image | image_url: width: 1200 }} 1200w, {{ v.featured_image | image_url: width: 2000 }} 2000w{%- endcapture -%}
              {%- endif -%}
              {"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }}{% if v.featured_image %},"image":{{ v.featured_image | image_url: width: 1200 | json }},"image_srcset":{{ v_srcset | json }}{% endif %}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
            ]
          </script>
          <input type="hidden" name="id" id="eeVariantId" value="{{ current_variant.id }}">
          <div class="ee-qty">
            <label for="Quantity-{{ section.id }}">Qty</label>
            <div class="ee-qty-stepper">
              <button type="button" data-qty-delta="-1" aria-label="Decrease quantity">−</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric">
              <button type="button" data-qty-delta="1" aria-label="Increase quantity">+</button>
            </div>
          </div>
          {%- liquid
            assign can_buy = false
            if current_variant.available and current_variant.price > 0
              assign can_buy = true
            endif
          -%}
          <button class="btn btn-primary" type="submit" name="add" id="eeAddBtn" {% unless can_buy %}disabled{% endunless %}>
            {% if current_variant.available == false %}Sold Out{% elsif current_variant.price == 0 %}Available In Store{% else %}Add to Cart{% endif %}
          </button>
          <button class="btn btn-secondary ee-wish-btn" type="button" data-wish-handle="{{ product.handle }}" data-wish-title="{{ product.title | escape }}" aria-pressed="false">
            <svg class="icon" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"></path></svg>
            <span data-wish-text>Save to Wishlist</span>
          </button>
        {% endform %}

        {% if product.description != blank %}
          <details class="ee-accordion" open>
            <summary>Details</summary>
            <div class="product-description">{{ product.description }}</div>
          </details>
        {% endif %}
        <details class="ee-accordion">
          <summary>Pickup & shipping</summary>
          <p>Local pickup at the Columbus flagship, 2100 Cleveland Ave. Shipping options and rates are shown at checkout. Layaway can be requested from the cart or in-store.</p>
        </details>
      </div>
    </div>

    <div class="ee-related">
      <div class="section-title"><div><h2>You may also like</h2><p>More from the Exclusive Essence catalog.</p></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all products →</a></div>
      <div class="product-shelf">
        {% assign shown = 0 %}
        {% if recommendations.performed and recommendations.products_count > 0 %}
          {% for rec in recommendations.products limit: 8 %}
            {% unless rec.id == product.id %}
              {% render 'product-card', product: rec %}
              {% assign shown = shown | plus: 1 %}
            {% endunless %}
          {% endfor %}
        {% endif %}
        {% if shown < 4 %}
          {% for rec in collections.all.products limit: 12 %}
            {% if shown >= 8 %}{% break %}{% endif %}
            {% unless rec.id == product.id %}
              {% render 'product-card', product: rec %}
              {% assign shown = shown | plus: 1 %}
            {% endunless %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<dialog class="ee-lightbox" id="eeLightbox" aria-label="Product image">
  <button type="button" class="icon-btn modal-close" data-close-lightbox aria-label="Close">×</button>
  <img id="eeLightboxImg" alt="{{ product.title | escape }}">
</dialog>

<script>
(function(){
  var thumbs = document.querySelectorAll('.ee-thumb');
  var main = document.querySelector('.ee-main-photo');
  var lightbox = document.getElementById('eeLightbox');
  var lightImg = document.getElementById('eeLightboxImg');
  function showImage(src, srcset){
    if(!main || !src) return;
    if(srcset){ main.srcset = srcset; } else { main.removeAttribute('srcset'); }
    main.src = src;
  }
  thumbs.forEach(function(btn){
    btn.addEventListener('click', function(){
      thumbs.forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('is-active'); btn.setAttribute('aria-pressed','true');
      showImage(btn.dataset.full, btn.dataset.srcset);
    });
  });
  document.getElementById('eeMainMedia')?.addEventListener('click', function(){
    if(!main || !lightbox || typeof lightbox.showModal !== 'function') return;
    lightImg.src = main.currentSrc || main.src;
    lightbox.showModal();
  });
  document.querySelector('[data-close-lightbox]')?.addEventListener('click', function(){ lightbox.close(); });
  lightbox?.addEventListener('click', function(e){ if(e.target === lightbox) lightbox.close(); });

  var form = document.getElementById('eeProductForm');
  if(!form) return;
  var variantInput = document.getElementById('eeVariantId');
  var addBtn = document.getElementById('eeAddBtn');
  var priceEl = document.querySelector('#eePrice [data-price]');
  var compareEl = document.querySelector('#eePrice [data-compare]');
  var qtyInput = form.querySelector('input[name="quantity"]');
  var variants = [];
  try { variants = JSON.parse(document.getElementById('eeVariantJson').textContent); } catch(e) {}
  function money(cents){
    return window.eeFormatMoney ? window.eeFormatMoney(cents) : '$' + (cents/100).toFixed(2);
  }
  function findVariant(){
    var opts = Array.prototype.map.call(form.querySelectorAll('fieldset'), function(fs){
      var checked = fs.querySelector('input:checked');
      return checked ? checked.value : null;
    });
    if(!opts.length) return variants[0] || null;
    return variants.find(function(v){
      return opts.every(function(o,i){ return v.options[i] === o; });
    }) || null;
  }
  function update(initial){
    var v = findVariant();
    if(!v){
      addBtn.disabled = true;
      addBtn.textContent = 'Unavailable';
      if(priceEl) priceEl.textContent = 'This combination is unavailable';
      if(compareEl) compareEl.hidden = true;
      return;
    }
    variantInput.value = v.id;
    if(priceEl) priceEl.textContent = v.price > 0 ? money(v.price) : 'Price available in store';
    if(compareEl){
      compareEl.hidden = !(v.compare_at_price > v.price);
      compareEl.textContent = v.compare_at_price > v.price ? money(v.compare_at_price) : '';
    }
    addBtn.disabled = !(v.available && v.price > 0);
    addBtn.textContent = !v.available ? 'Sold Out' : (v.price > 0 ? 'Add to Cart' : 'Available In Store');
    if(initial) return;
    if(v.image) showImage(v.image, v.image_srcset);
    try {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', v.id);
      window.history.replaceState({}, '', url.toString());
    } catch(e) {}
  }
  form.addEventListener('change', function(e){
    if(e.target.name && e.target.name.indexOf('options[') === 0) update();
  });
  form.querySelectorAll('[data-qty-delta]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var next = Math.max(1, (parseInt(qtyInput.value, 10) || 1) + Number(btn.dataset.qtyDelta));
      qtyInput.value = String(next);
    });
  });
  qtyInput?.addEventListener('change', function(){
    var n = parseInt(qtyInput.value, 10);
    qtyInput.value = String(n > 0 ? n : 1);
  });
  if(form.querySelector('fieldset')) update(true);
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},
    {"type":"checkbox","id":"show_pickup","label":"Show Columbus pickup note","default":true}
  ]
}
{% endschema %}
