<div class="entry-gate" style="display:flex">
  <div class="entry-gate-card">
    <img class="gate-logo" src="{{ 'b277e37070df.png' | asset_url }}" alt="{{ shop.name }}">
    <p class="gate-kicker">The Essence Way!</p>
    <h2>{{ shop.name }}</h2>
    <p>{{ shop.password_message | default: 'Our storefront is opening soon. Enter the store password to preview.' }}</p>
    {% form 'storefront_password' %}
      <label class="sr-only" for="Password">Password</label>
      <input type="password" name="password" id="Password" placeholder="Store password" required>
      <button class="btn btn-primary" type="submit">Enter the Store</button>
    {% endform %}
  </div>
</div>
{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
