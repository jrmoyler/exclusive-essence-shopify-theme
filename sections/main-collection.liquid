{% liquid
  assign ee_collection = collection
  assign ee_fallback = false
  if collection == blank or collection.all_products_count == 0
    assign ee_collection = collections.all
    assign ee_fallback = true
  endif
  assign sort_base = collection.url
  if ee_fallback
    assign sort_base = routes.all_products_collection_url
  endif
  assign current_handle = collection.handle | default: 'all'
%}
<section class="section catalog dedicated-catalog is-open ee-collection-page" id="catalog">
  <div class="container">
    <div class="catalog-view-head">
      <a class="catalog-back" href="{{ routes.root_url }}">← Back to home</a>
      <div>
        <h1>{{ collection.title | default: 'Product Catalog' }}</h1>
        <p id="catalogCount">
          {% if ee_fallback and collection.handle != blank and collection.handle != 'all' %}
            {{ collection.title }} is being stocked online — here is the full catalog in the meantime. Visit the Columbus store for the complete {{ collection.title }} selection.
          {% elsif collection.description != blank %}
            {{ collection.description | strip_html | truncate: 180 }}
          {% else %}
            Every product in the Exclusive Essence assortment — human hair, care, color, tools and more.
          {% endif %}
        </p>
      </div>
    </div>

    <div class="catalog-tools">
      {% render 'department-chips', current: current_handle %}
      <div class="catalog-actions">
        <form action="{{ sort_base }}" method="get" class="ee-sort-form">
          <label class="sr-only" for="SortBy">Sort products</label>
          <select id="SortBy" name="sort_by" onchange="this.form.submit()">
            {%- assign sort_current = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if sort_current == option.value %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- else -%}
              <option value="manual">Featured</option>
              <option value="price-ascending"{% if sort_current == 'price-ascending' %} selected{% endif %}>Price, low to high</option>
              <option value="price-descending"{% if sort_current == 'price-descending' %} selected{% endif %}>Price, high to low</option>
              <option value="title-ascending"{% if sort_current == 'title-ascending' %} selected{% endif %}>Alphabetically, A-Z</option>
            {%- endfor -%}
          </select>
          <noscript><button class="btn btn-secondary" type="submit">Sort</button></noscript>
        </form>
      </div>
    </div>

    {% paginate ee_collection.products by section.settings.per_page %}
      <p class="ee-catalog-count">{{ paginate.items }} product{% if paginate.items != 1 %}s{% endif %}{% if paginate.pages > 1 %} · Page {{ paginate.current_page }} of {{ paginate.pages }}{% endif %}</p>
      {% if ee_collection.products.size == 0 %}
        <div class="catalog-empty" style="display:block">
          No products in this collection yet. Browse the full store catalog while department collections are created in Shopify Admin.
          <div class="hero-actions" style="justify-content:center;margin-top:18px">
            <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">View all products</a>
          </div>
        </div>
      {% else %}
        <div class="product-shelf">
          {% for product in ee_collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="pagination" aria-label="Collection pages">
            {{ paginate | default_pagination: next: 'Next ›', previous: '‹ Previous' }}
          </nav>
        {% endif %}
      {% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{
  "name": "Collection",
  "settings": [
    {"type":"range","id":"per_page","min":24,"max":48,"step":8,"label":"Products per page","default":48}
  ]
}
{% endschema %}
