<section class="ee-shopify-main">
  <div class="container" style="max-width:860px">
    <nav class="ee-breadcrumb"><a href="{{ blog.url }}">{{ blog.title }}</a><span>/</span><span>{{ article.title }}</span></nav>
    <h1>{{ article.title }}</h1>
    <p class="ee-lede">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</p>
    {% if article.image %}
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" style="border-radius:16px;margin:0 0 28px">
    {% endif %}
    <div class="rte">{{ article.content }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
