<section class="ee-shopify-main customer">
  <div class="container">
    <nav class="ee-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <a href="{{ routes.account_login_url }}">Account</a>
      <span>/</span>
      <span>Create</span>
    </nav>
    <h1>Create account</h1>
    <p class="ee-lede">Join Exclusive Essence to track orders, save addresses and check out faster.</p>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <label class="sr-only" for="RegisterFirstName">First name</label>
      <input id="RegisterFirstName" type="text" name="customer[first_name]" placeholder="First name" autocomplete="given-name">
      <label class="sr-only" for="RegisterLastName">Last name</label>
      <input id="RegisterLastName" type="text" name="customer[last_name]" placeholder="Last name" autocomplete="family-name">
      <label class="sr-only" for="RegisterEmail">Email</label>
      <input id="RegisterEmail" type="email" name="customer[email]" placeholder="Email address" required autocomplete="email">
      <label class="sr-only" for="RegisterPassword">Password</label>
      <input id="RegisterPassword" type="password" name="customer[password]" placeholder="Password (5+ characters)" required minlength="5" autocomplete="new-password">
      <button class="btn btn-primary" type="submit">Create account</button>
      <a href="{{ routes.account_login_url }}">Already have an account? Sign in</a>
    {% endform %}
  </div>
</section>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
