<section class="ee-shopify-main customer">
  <div class="container">
    <h1>Addresses</h1>
    {% paginate customer.addresses by 5 %}
      {% for address in customer.addresses %}
        <article class="store-card" style="margin-bottom:16px">
          {% if address == customer.default_address %}<span class="store-badge open">Default</span>{% endif %}
          {{ address | format_address }}
        </article>
      {% endfor %}
      {% endpaginate %}
    {% form 'customer_address', customer.new_address %}
      <h2 style="font-family:Georgia,serif">Add address</h2>
      <input type="text" name="address[first_name]" placeholder="First name">
      <input type="text" name="address[last_name]" placeholder="Last name">
      <input type="text" name="address[address1]" placeholder="Address">
      <input type="text" name="address[city]" placeholder="City">
      <input type="text" name="address[zip]" placeholder="ZIP">
      <button class="btn btn-primary" type="submit">Save address</button>
    {% endform %}
  </div>
</section>
{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
