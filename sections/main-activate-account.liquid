<section class="ee-shopify-main customer">
  <div class="container">
    <h1>Activate account</h1>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <label for="activatePassword">Password</label>
      <input id="activatePassword" type="password" name="customer[password]" required minlength="5" autocomplete="new-password">
      <label for="activatePasswordConfirm">Confirm password</label>
      <input id="activatePasswordConfirm" type="password" name="customer[password_confirmation]" required minlength="5" autocomplete="new-password">
      <button class="btn btn-primary" type="submit">Activate account</button>
      <button class="btn btn-secondary" type="submit" name="decline" formnovalidate>Decline invitation</button>
    {% endform %}
  </div>
</section>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
