<section class="ee-shopify-main customer">
  <div class="container">
    <h1>Reset password</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="New password">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password">
      <button class="btn btn-primary" type="submit">Reset password</button>
    {% endform %}
  </div>
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
