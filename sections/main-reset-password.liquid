<section class="ee-shopify-main customer">
  <div class="container">
    <h1>Reset password</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <label for="resetPassword">New password</label>
      <input id="resetPassword" type="password" name="customer[password]" required minlength="5" autocomplete="new-password">
      <label for="resetPasswordConfirm">Confirm password</label>
      <input id="resetPasswordConfirm" type="password" name="customer[password_confirmation]" required minlength="5" autocomplete="new-password">
      <button class="btn btn-primary" type="submit">Reset password</button>
    {% endform %}
  </div>
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
