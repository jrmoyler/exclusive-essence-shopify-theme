<section class="ee-shopify-main">
  <div class="container">
    <nav class="ee-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span>Cart</span>
    </nav>
    <h1>Your Cart</h1>
    {% if cart.item_count == 0 %}
      <div class="ee-empty">
        <h2>Your cart is empty.</h2>
        <p>Start with the catalog — human hair, hair care, color and everyday essentials.</p>
        <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Start Shopping</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="ee-cart-form" id="cartPageForm">
        <table class="cart-table">
          <thead>
            <tr><th>Product</th><th>Qty</th><th>Total</th></tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td>
                  <div class="ee-cart-item">
                    <a href="{{ item.url }}">
                      {% if item.image %}
                        {% render 'hi-res-image', image: item.image, alt: item.title, sizes: '84px', class: 'ee-cart-thumb' %}
                      {% else %}
                        <img class="ee-cart-thumb" src="{{ 'e76907a047b4.webp' | asset_url }}" alt="{{ item.title | escape }}" width="440" height="380">
                      {% endif %}
                    </a>
                    <div>
                      <strong><a href="{{ item.url }}">{{ item.product.title }}</a></strong><br>
                      {% unless item.product.has_only_default_variant %}
                        <small>{{ item.variant.title }}</small><br>
                      {% endunless %}
                      {% if item.vendor != blank %}<small>{{ item.vendor }}</small><br>{% endif %}
                      <a class="remove" href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                </td>
                <td>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric" aria-label="Quantity for {{ item.title | escape }}">
                </td>
                <td>{% if item.original_line_price != item.final_line_price %}<s class="ee-compare">{{ item.original_line_price | money }}</s><br>{% endif %}<b>{{ item.final_line_price | money }}</b></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="cart-summary">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="total-row ee-discount"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="total-row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <p class="ee-lede">Taxes and shipping calculated at checkout. Columbus pickup is available at 2100 Cleveland Ave.</p>
          <button class="btn btn-primary" type="submit" name="checkout">Checkout Securely</button>
          <button class="btn btn-secondary" type="submit" name="update">Update cart</button>
          <p class="ee-lede">Prefer to pay over time? <button type="button" class="ee-link-btn" data-start-layaway>Request a Layaway Plan</button> — 25% deposit, 45-day term.</p>
        </div>
      </form>
    {% endif %}

    <div class="ee-related">
      <div class="section-title">
        <div>
          <h2>Keep shopping</h2>
          <p>More from the Exclusive Essence catalog.</p>
        </div>
        <a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all products →</a>
      </div>
      <div class="product-shelf">
        {% for product in collections.all.products limit: 8 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
