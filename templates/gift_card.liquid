{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gift card – {{ shop.name }}</title>
  {{ 'ee.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="ee-shopify-main">
    <div class="container ee-gift">
      <img src="{{ 'b277e37070df.png' | asset_url }}" alt="{{ shop.name | escape }}" width="700" height="545">
      <p class="curated-kicker">The Essence Way!</p>
      <h1>Gift card</h1>
      <p class="ee-lede">{{ gift_card.balance | money }} remaining{% unless gift_card.enabled %} · disabled{% endunless %}</p>
      <p class="ee-gift-code">{{ gift_card.code | format_code }}</p>
      {% if gift_card.qr_image_url %}
        <img src="{{ gift_card.qr_image_url }}" alt="Gift card QR code" width="120" height="120">
      {% endif %}
      {% if gift_card.pass_url %}
        <p><a class="btn btn-primary" href="{{ gift_card.pass_url }}">Add to Apple Wallet</a></p>
      {% endif %}
      <p><a class="btn btn-secondary" href="{{ shop.url }}">Shop {{ shop.name }}</a></p>
    </div>
  </main>
</body>
</html>
